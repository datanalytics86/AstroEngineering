# Desarrollo local (frontend/.env.local — gitignored)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Producción en Vercel: si faltan, next.config.mjs usa
# https://astroengine-backend.onrender.com (nunca el stub astroengine.onrender.com).
# NEXT_PUBLIC_API_URL=https://astroengine-backend.onrender.com
# BACKEND_URL=https://astroengine-backend.onrender.com
# NEXT_PUBLIC_SITE_URL=https://astro-engineering.vercel.app

# Obligatorio en producción (mismo valor en Vercel y Render). Sin él, el
# backend con ENV=production responde 403 a todo excepto GET /health.
# BACKEND_PROXY_KEY=

# Opcionales (fail-soft; no commitear valores reales)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
